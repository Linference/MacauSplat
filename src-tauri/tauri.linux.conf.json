{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build:bundle:linux"
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "resources": {
      "../licenses/FFmpeg-CORRESPONDING-SOURCE.txt": "licenses/FFmpeg-CORRESPONDING-SOURCE.txt",
      "../engines/manifest.linux.json": "engines/manifest.linux.json",
      "../engines/linux/brush/": "engines/linux/brush/"
    },
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "colmap"
        ],
        "recommends": [
          "libvulkan1",
          "mesa-vulkan-drivers"
        ],
        "section": "graphics",
        "priority": "optional"
      }
    },
    "externalBin": [
      "binaries/splatstudio"
    ]
  }
}
