{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacauSplat",
  "version": "0.4.1",
  "identifier": "studio.ooo.splat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bundle",
    "frontendDist": "../dist"
  },  "app": {
    "windows": [
      {
        "title": "MacauSplat",
        "width": 1500,
        "height": 850,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#eef1f5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": {
      "../licenses/THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt",
      "../licenses/FFmpeg-LGPL-2.1.txt": "licenses/FFmpeg-LGPL-2.1.txt",
      "../licenses/FFmpeg-CORRESPONDING-SOURCE.txt": "licenses/FFmpeg-CORRESPONDING-SOURCE.txt",
      "../licenses/COLMAP-LICENSE.txt": "licenses/COLMAP-LICENSE.txt",
      "../licenses/NVIDIA-CUDA-Runtime.txt": "licenses/NVIDIA-CUDA-Runtime.txt",
      "../licenses/Brush-LICENSE.txt": "licenses/Brush-LICENSE.txt",
      "../licenses/PlayCanvas-MIT.txt": "licenses/PlayCanvas-MIT.txt",
      "../licenses/Mediabunny-MPL-2.0.txt": "licenses/Mediabunny-MPL-2.0.txt",
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../TRADEMARK_POLICY.md": "TRADEMARK_POLICY.md",
      "../GENERATED_OUTPUTS.md": "GENERATED_OUTPUTS.md"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "compression": "bzip2",
        "languages": [
          "TradChinese",
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "publisher": "Linference",
    "copyright": "Copyright © 2026 Linference. 基於 OOOSplat（Apache-2.0）的衍生作品。",
    "category": "GraphicsAndDesign",
    "shortDescription": "從環繞影片生成 3DGS，並自動產出帶精確標註的建築資料集",
    "longDescription": "MacauSplat 把一段環繞拍攝的影片轉成兩種成果：可瀏覽的三維高斯潑濺模型，以及帶精確標註的建築資料集。重建沿用開源工具（FFmpeg、COLMAP、Brush）；本作品的貢獻在重建之後的自動標註階段——由 COLMAP 的相機位姿與稀疏點雲投影出幾何一致、可稽核的二維標註，並內建建圖過程的即時三維點雲檢視。"
  }
}
